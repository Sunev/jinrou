section.lobby
  h1 历史检索
  form#logsform
    fieldset
      legend 条件
      fieldset(style="display:none")
        legend 人数
        p
          input(name="min_number_on",type="checkbox",disabled)
          input(name="min_number",type="number",value="3",disabled)
          | 人以上
        p
          input(name="max_number_on",type="checkbox",disabled)
          input(name="max_number",type="number",value="17",disabled)
          | 人以下
      p
        input(name="result_team_on",type="checkbox")
        | 获胜者
        select(name="result_team",disabled)#winnerbox
      fieldset
        legend 结束前的天数
        p
          input(name="min_day_on",type="checkbox")
          input(name="min_day",type="number",value="1",disabled)
          | 天以上
        p
          input(name="max_day_on",type="checkbox")
          input(name="max_day",type="number",value="10",disabled)
          | 天以下
      fieldset
        legend 规则
        p
          input(name="rule_on",type="checkbox")
          select(name="rule",disabled)#rulebox
       
    p: input(type="submit",value="检索")
      
  form#pager
    p
      input(type="button",name="prev",value="上一页",disabled)
      input(type="button",name="next",value="下一页",disabled)
  table.roomstable
    thead
      tr
        th 房间号
        th 房间名
        th 房主
        th 人数
        th 创建时间
        th 获胜者
        th 规则
        th 天数
    tbody#roomlist

